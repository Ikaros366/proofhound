# 环境与密钥（仓库卫生红线）
.env

# 运行时证据与审计归档，永不入库
evidence/*
!evidence/.gitkeep

# API engagement 运行目录（M5a，含审计/证据/会话凭据）
engagements/

# 管理面运行时产物（M6a，--workspace . 时落仓库根）
management.jsonl
/scopes/

# 工具安装产物与版本快照（运行时状态）
tools.d/*
!tools.d/.gitkeep

# 私有企业模板（用户本机保留不入库；缺失时 enterprise 测试/演示自动 skip）
templates/custom_enterprise_template.docx

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
build/
dist/

# Windows 下载标记垃圾
*:Zone.Identifier
