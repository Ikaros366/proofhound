# ProofHound 环境配置样例
# 用法：cp .env.example .env，填入真实值。.env 永不入库（.gitignore 已覆盖）。
# 同名环境变量优先于 .env 文件值。

# ---- 三档模型端点（OpenAI 兼容协议） ----
# 红线 4：Verifier（T2）与发现端（T1）必须使用不同模型；T1==T2 同模型启动即警告。
# T0 档：解析/分类/去重/润色（廉价模型；当前主链路未强制使用，可选）
PROOFHOUND_T0_BASE_URL=
PROOFHOUND_T0_API_KEY=
PROOFHOUND_T0_MODEL=
# PROOFHOUND_T0_TEMPERATURE=0.2
# PROOFHOUND_T0_MAX_TOKENS=4096

# T1 档：规划 / triage / 报告叙述（Quickstart 必需）
PROOFHOUND_T1_BASE_URL=
PROOFHOUND_T1_API_KEY=
PROOFHOUND_T1_MODEL=
# PROOFHOUND_T1_TEMPERATURE=0.2
# PROOFHOUND_T1_MAX_TOKENS=4096

# T2 档：漏洞推理 / Verifier 终审（Confirmed 必需）
PROOFHOUND_T2_BASE_URL=
PROOFHOUND_T2_API_KEY=
PROOFHOUND_T2_MODEL=
# PROOFHOUND_T2_TEMPERATURE=0.2
# PROOFHOUND_T2_MAX_TOKENS=4096

# ---- 预算硬闸（与 scope 同级，不可绕过） ----
# Run 级 token 预算：未设 = 不限；0 = 拒绝一切 LLM 调用
# PROOFHOUND_MAX_TOKENS_PER_RUN=
# 分档预算上限（可选）
# PROOFHOUND_MAX_TOKENS_PER_RUN_T0=
# PROOFHOUND_MAX_TOKENS_PER_RUN_T1=
# PROOFHOUND_MAX_TOKENS_PER_RUN_T2=

# ---- 上下文治理 ----
# PROOFHOUND_CONTEXT_MAX_SIGNALS=20   # Signal 摘要超过即按 kind 聚合压缩
# PROOFHOUND_CONTEXT_KEEP_LATEST=5    # 压缩时每类保留最新条数
# PROOFHOUND_CONTEXT_MAX_CHARS=32000  # prompt 字符硬上限（超限任务 failed，禁静默截断）
